# physical-ai-triage environment template
# Copy to .env and fill in. .env is gitignored.
# Source of truth: live .env on the build machine.

# --- Primary cloud bucket (AWS S3) ---
# Per DECISIONS.md #2: storage is cloud-agnostic via BUCKET_URI.
# Scheme can be s3://, gs://, or file:// — fsspec picks the backend.
BUCKET_URI=s3://your-bucket-name
AWS_REGION=us-east-2

# --- Subpaths inside BUCKET_URI (no trailing slash) ---
WAYMO_PREFIX=waymo
BDD100K_PREFIX=bdd100k
NUSCENES_PREFIX=nuscenes
AV2_PREFIX=av2
THUMBNAILS_PREFIX=thumbnails
EMBEDDINGS_PREFIX=embeddings
INDEX_PREFIX=index

# --- Embedding model ---
# Default is siglip-base (768d). Switch to siglip-large for quality stretch.
EMBED_MODEL=google/siglip-base-patch16-224
EMBED_DEVICE=cuda

# --- Waymo BigQuery (extraction SOURCE only — sink is S3) ---
# Per DECISIONS.md #3: Waymo Open Dataset stays on BQ for extraction;
# parquet output lands in s3://$BUCKET_URI/$WAYMO_PREFIX/.
WAYMO_BQ_DATASET=bigquery-public-data.waymo_open_dataset_v_2_0_0
WAYMO_SEGMENTS_COUNT=150
WAYMO_SAMPLING_HZ=1
